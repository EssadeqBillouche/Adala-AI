					"name": "Register New User & Org",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"User profile and org are returned successfully\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('user');",
									"    pm.expect(jsonData.user).to.have.property('id');",
									"    pm.expect(jsonData.user.email).to.eql(\"john.doe@adala.ai\");",
									"    pm.expect(jsonData.user.organization).to.have.property('id');",
									"});",
									"",
									"// Capture access_token cookie if present and set environment variable",
									"const token = pm.cookies.get('access_token');",
									"if (token) {",
									"    pm.environment.set(\"jwt_token\", token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john.doe@adala.ai\",\n    \"password\": \"SecurePass123!\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"organizationName\": \"Adala Legal Intelligence\"\n}"
