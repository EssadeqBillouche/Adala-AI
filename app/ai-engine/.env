# AdalaAI Legal Engine Configuration

# =============================================================================
# QDRANT CONFIGURATION
# =============================================================================
# Qdrant vector database URL (local or cloud)
QDRANT_URL=http://qdrant:6333

# Qdrant API key (optional, for cloud deployments)
# QDRANT_API_KEY=your-api-key-here

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# LLM API endpoint (Ollama, vLLM, OpenAI-compatible)
# For Docker: use host.docker.internal to reach host machine
# For production: use http://llm:11434 if LLM runs in separate container
LLM_API_URL=http://host.docker.internal:11434/api/chat

# LLM API key (optional, for authenticated APIs)
# LLM_API_KEY=your-api-key-here

# LLM model name
LLM_MODEL=qwen2.5-72b-instruct

# =============================================================================
# EMBEDDING MODEL
# =============================================================================
# BGE-M3 is used by default (multilingual: Arabic/French/English)
# No configuration needed - model is loaded automatically via FastEmbed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
