# =============================================================================
# AdalaAI Legal Engine — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control (it is in .gitignore).
# =============================================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- CORS (comma-separated, no wildcards) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=          # Only needed for cloud Qdrant

# --- LLM Provider ---
# Options: gemini | openai_compatible
LLM_PROVIDER=gemini

# Gemini (required when LLM_PROVIDER=gemini)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyCJtsaCaos2FfKKMZsjTXxjyVeJI0C30E4
LLM_MODEL=gemini-2.0-flash

# OpenAI-compatible (required when LLM_PROVIDER=openai_compatible)
# LLM_API_URL=http://localhost:11434/api/chat
# LLM_API_KEY=
# LLM_MODEL=qwen2.5-72b-instruct

# --- Security (optional) ---
# When set, every request (except /health) must include a matching
# X-API-Secret header.  Leave unset for Docker Compose deployments
# where network isolation is sufficient.
# INTERNAL_API_SECRET=change-me-to-a-random-string
